# Copy this file to .env and fill in the values. Never commit the real .env file.

# PostgreSQL connection string. The Prisma client uses the Neon serverless adapter,
# so a Neon connection string is expected (e.g. postgresql://user:password@host/db?sslmode=require).
DATABASE_URL=

# NextAuth.js
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
# Public base URL of the app. Use http://localhost:3000 locally and your domain in production.
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini API key for the Education assistant (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Shared secret for the recurring transactions cron endpoint (/api/cron/recurring).
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>". Use a different value per environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
